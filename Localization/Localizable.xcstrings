    "Finder k této položce nic nevrátil.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Finder hat zu diesem Objekt nichts zurückgemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Finder returned nothing for this item."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Finder no devolvió nada para este elemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Finder n'a rien renvoyé pour cet élément."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस आइटम के लिए Finder ने कुछ नहीं लौटाया।"
          }
        }
      }
    },
    "Finder neodpověděl. Zkuste to znovu, nebo položku přesuňte ručně.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Finder hat nicht geantwortet. Versuchen Sie es erneut oder bewegen Sie das Objekt selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Finder did not answer. Try again, or move the item yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Finder no respondió. Inténtalo de nuevo o mueve el elemento tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Finder n'a pas répondu. Réessayez ou déplacez l'élément vous-même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder ने उत्तर नहीं दिया। दोबारा प्रयास करें या आइटम स्वयं हटाएँ।"
          }
        }
      }
    },
    "Finder operaci nedokončil.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Finder hat den Vorgang nicht abgeschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Finder did not complete the operation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Finder no completó la operación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Finder n'a pas terminé l'opération."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder ने कार्य पूरा नहीं किया।"
          }
        }
      }
    },
    "Finder položku nepřesunul.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Finder hat das Objekt nicht bewegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Finder did not move the item."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Finder no movió el elemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Finder n'a pas déplacé l'élément."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder ने आइटम नहीं हटाया।"
          }
        }
      }
    },
    "Finder si vyžádá heslo správce. Nimbo heslo nevidí a nic nespouští s právy roota.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Finder fragt nach einem Administratorkennwort. Nimbo sieht es nie und führt nichts als Root aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Finder will ask for an administrator password. Nimbo never sees it and runs nothing as root."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Finder pedirá una contraseña de administrador. Nimbo nunca la ve y no ejecuta nada como root."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Finder demandera un mot de passe administrateur. Nimbo ne le voit jamais et n'exécute rien en root."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder व्यवस्थापक पासवर्ड माँगेगा। Nimbo उसे कभी नहीं देखता और root अधिकारों से कुछ नहीं चलाता।"
          }
        }
      }
    },
