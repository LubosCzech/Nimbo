    "Nebyly nalezeny žádné související soubory.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden keine zugehörigen Dateien gefunden."
          }
        },
        "en": {
