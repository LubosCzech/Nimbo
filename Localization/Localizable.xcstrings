    "Cache a logy budou přesunuty do Koše. Obsah Koše je jediná nevratná operace.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches und Protokolle wandern in den Papierkorb. Nur das Leeren des Papierkorbs lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches and logs will be moved to the Trash. Emptying the Trash is the only step that cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cachés y los registros irán a la papelera. Vaciar la papelera es la única operación irreversible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les caches et journaux iront dans la corbeille. Vider la corbeille est la seule opération irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैश और लॉग ट्रैश में जाएँगे। ट्रैश खाली करना ही एकमात्र अपरिवर्तनीय कार्य है।"
          }
        }
      }
    },
