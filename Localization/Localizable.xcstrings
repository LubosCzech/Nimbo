    "Vybráno %@. Cache lze znovu vytvořit, simulátory, runtime a SDK mohou vyžadovat nové stažení.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ausgewählt. Caches lassen sich neu anlegen; Simulatoren, Laufzeiten und SDKs müssen eventuell erneut geladen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ selected. Caches can be recreated; simulators, runtimes and SDKs may need downloading again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seleccionados. Las cachés se vuelven a crear; los simuladores, entornos y SDK pueden requerir una nueva descarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sélectionnés. Les caches se recréent ; simulateurs, runtimes et SDK devront peut-être être retéléchargés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ चयनित। कैश फिर बन जाते हैं; सिम्युलेटर, रनटाइम और SDK दोबारा डाउनलोड करने पड़ सकते हैं।"
          }
        }
      }
    },
    "Vybráno %@. Detekce je konzervativní, přesto doporučujeme seznam zkontrolovat.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ausgewählt. Die Erkennung ist zurückhaltend, sehen Sie die Liste dennoch durch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ selected. Detection is conservative, but do look the list over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seleccionados. La detección es conservadora, pero conviene revisar la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sélectionnés. La détection est prudente, parcourez tout de même la liste."
