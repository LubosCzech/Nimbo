          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui ralentit le Mac"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac को क्या धीमा करता है"
          }
        }
      }
    },
