    "Aplikace, velké soubory, cache a logy se nejprve přesouvají do Koše.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, große Dateien, Caches und Protokolle wandern zuerst in den Papierkorb."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, large files, caches and logs go to the Trash first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps, los archivos grandes, las cachés y los registros pasan primero por la papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps, fichiers volumineux, caches et journaux passent d'abord par la corbeille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप्स, बड़ी फ़ाइलें, कैश और लॉग पहले ट्रैश में जाते हैं।"
          }
        }
      }
    },
