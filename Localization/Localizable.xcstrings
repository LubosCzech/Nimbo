    "%@ byla přesunuta do Koše včetně vybraných zbytků.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde mit den ausgewählten Restdaten in den Papierkorb bewegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was moved to the Trash, together with the selected leftovers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se movió a la papelera junto con los restos seleccionados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été placée dans la corbeille avec les résidus sélectionnés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को चुने गए बचे हुए डेटा सहित ट्रैश में ले जाया गया।"
          }
        }
