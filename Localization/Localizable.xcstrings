    "Neopravuje oprávnění disku. Od macOS 10.11 se o systémové soubory stará sám systém.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es repariert keine Volume-Zugriffsrechte. Seit macOS 10.11 kümmert sich das System selbst um seine Dateien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It does not repair disk permissions. Since macOS 10.11 the system looks after its own files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No repara los permisos del disco. Desde macOS 10.11 el sistema cuida de sus propios archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne répare pas les autorisations du disque. Depuis macOS 10.11, le système gère lui-même ses fichiers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिस्क अनुमतियाँ ठीक नहीं करता। macOS 10.11 से सिस्टम अपनी फ़ाइलें स्वयं संभालता है।"
          }
        }
      }
    },
    "Nespouští periodické skripty. Na dnešním macOS už neexistují.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es führt keine periodischen Skripte aus. Im heutigen macOS gibt es sie nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It does not run periodic scripts. They no longer exist on today's macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No ejecuta scripts periódicos. Ya no existen en el macOS actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'exécute pas les scripts périodiques. Ils n'existent plus sur macOS actuel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आवधिक स्क्रिप्ट नहीं चलाता। आज के macOS में वे मौजूद ही नहीं हैं।"
          }
        }
      }
    },
    "Neukončuje procesy. Ukáže je; ukončení patří do Monitoru aktivity.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es beendet keine Prozesse. Es zeigt sie an; das Beenden gehört in die Aktivitätsanzeige."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It does not quit processes. It shows them; quitting belongs in Activity Monitor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cierra procesos. Los muestra; cerrarlos corresponde al Monitor de Actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne quitte pas les processus. Il les affiche ; les quitter relève du Moniteur d'activité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह प्रक्रियाएँ बंद नहीं करता। उन्हें दिखाता है; बंद करना Activity Monitor का काम है।"
          }
        }
      }
    },
    "Neuvolňuje paměť. macOS v ní drží data, aby je nemusel číst z disku; vyprázdnit ji znamená příští čtení zpomalit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keinen Speicher frei. macOS hält dort Daten, um nicht von der Festplatte lesen zu müssen; ihn zu leeren macht den nächsten Lesevorgang nur langsamer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It does not free memory. macOS keeps data there so it need not read from disk; emptying it only makes the next read slower."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No libera memoria. macOS guarda datos allí para no leer del disco; vaciarla solo hace más lenta la siguiente lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne libère pas la mémoire. macOS y conserve des données pour éviter de lire le disque ; la vider ne fait que ralentir la lecture suivante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मेमोरी खाली नहीं करता। macOS उसमें डेटा रखता है ताकि डिस्क से न पढ़ना पड़े; उसे खाली करने से अगली पढ़ाई ही धीमी होती है।"
          }
        }
      }
    },
