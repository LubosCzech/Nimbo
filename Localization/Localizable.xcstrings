          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien trouvé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ नहीं मिला"
          }
        }
      }
    },
    "Nic se neodstraní bez vašeho potvrzení.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Ihre Bestätigung wird nichts entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is removed without your confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se elimina nada sin tu confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est supprimé sans votre confirmation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पुष्टि के बिना कुछ नहीं हटाया जाता।"
          }
        }
      }
    },
    "Nimbo dělá nezávislé studio bez reklam a bez odesílání vašich dat. Když vám šetří místo i čas, můžete nás pozvat na kávu.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimbo stammt von einem unabhängigen Studio, ohne Werbung und ohne Ihre Daten zu versenden. Wenn es Ihnen Platz und Zeit spart, können Sie uns einen Kaffee spendieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimbo is made by an independent studio, with no ads and without sending your data anywhere. If it saves you space and time, you can buy us a coffee."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimbo lo hace un estudio independiente, sin anuncios y sin enviar tus datos a ninguna parte. Si te ahorra espacio y tiempo, puedes invitarnos a un café."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimbo est réalisé par un studio indépendant, sans publicité et sans envoyer vos données. S'il vous fait gagner de l'espace et du temps, vous pouvez nous offrir un café."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimbo एक स्वतंत्र स्टूडियो बनाता है — बिना विज्ञापन और आपका डेटा भेजे बिना। यदि यह आपकी जगह और समय बचाता है, तो आप हमें एक कॉफ़ी पिला सकते हैं।"
          }
        }
      }
    },
    "Nimbo kontroluje potřebný přístup při každém spuštění.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimbo prüft bei jedem Start den benötigten Zugriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimbo checks the access it needs at every launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimbo comprueba en cada inicio el acceso que necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimbo vérifie à chaque lancement l'accès dont il a besoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimbo हर बार शुरू होने पर आवश्यक पहुँच जाँचता है।"
          }
        }
      }
    },
    "Nimbo ukáže, co má na rychlost skutečný vliv. Měří se při otevření sekce.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
