    "Místa je dost. Nízké volné místo je nejčastější skutečná příčina zpomalení.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist genug Platz vorhanden. Wenig freier Speicher ist die häufigste echte Ursache für Verlangsamung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is plenty of space. Low free space is the most common real cause of slowdowns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay espacio de sobra. La falta de espacio libre es la causa real más común de lentitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace est suffisant. Le manque d'espace libre est la cause réelle la plus fréquente de ralentissement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जगह पर्याप्त है। कम खाली जगह धीमेपन का सबसे आम वास्तविक कारण है।"
          }
        }
      }
    },
