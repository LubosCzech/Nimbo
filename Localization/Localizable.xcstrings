            "value": "Independent software studio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estudio de software independiente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio logiciel indépendant"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वतंत्र सॉफ़्टवेयर स्टूडियो"
          }
        }
      }
    },
    "Nic nenalezeno": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts gefunden"
          }
        },
        "en": {
