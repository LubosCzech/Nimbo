    "Co startuje s Macem, zpomaluje ho po celou dobu běhu. Tohle bývá největší rozdíl.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was mit dem Mac startet, bremst ihn die ganze Laufzeit über. Hier liegt meist der größte Unterschied."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whatever starts with the Mac slows it down the whole time it runs. This usually makes the biggest difference."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que arranca con el Mac lo ralentiza mientras está encendido. Aquí suele estar la mayor diferencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui démarre avec le Mac le ralentit tout au long de son fonctionnement. C'est généralement ce qui change le plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो कुछ Mac के साथ शुरू होता है, वह पूरे समय उसे धीमा करता है। आमतौर पर यहीं सबसे बड़ा फ़र्क पड़ता है।"
          }
        }
      }
    },
    "Co zpomaluje Mac": {
      "extractionState": "manual",
      "localizations": {
