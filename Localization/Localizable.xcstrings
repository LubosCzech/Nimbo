            "value": "Wenn Google normale Ergebnisse liefert, öffnen Sie den KI-Modus im Browser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Google returns ordinary results, open AI Mode in the browser."
          }
        },
        "es": {
          "stringUnit": {
