    "Volba Podle systému respektuje vzhled macOS. Průhlednost a pohyb se přizpůsobují nastavení zpřístupnění.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Wie System“ folgt dem Erscheinungsbild von macOS. Transparenz und Bewegung richten sich nach den Bedienungshilfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match system follows the macOS appearance. Transparency and motion follow the accessibility settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Según el sistema» sigue la apariencia de macOS. La transparencia y el movimiento siguen los ajustes de accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Selon le système » suit l'apparence de macOS. La transparence et le mouvement suivent les réglages d'accessibilité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "„सिस्टम के अनुसार“ macOS के रूप का पालन करता है। पारदर्शिता और गति सुगम्यता सेटिंग्स के अनुसार चलती हैं।"
          }
        }
      }
    },
    "Volitelné: potřebné pro čtení a změnu přihlašovacích aplikací, ne pro úklid.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: nötig zum Lesen und Ändern von Anmelde-Apps, nicht zum Bereinigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: needed to read and change login apps, not for cleaning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: necesario para leer y cambiar las apps de inicio de sesión, no para limpiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : nécessaire pour lire et modifier les apps d'ouverture de session, pas pour le nettoyage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक: लॉगिन ऐप्स पढ़ने और बदलने हेतु आवश्यक, सफ़ाई हेतु नहीं।"
          }
        }
      }
    },
