    "Kontrola jednou denně. Stažení a instalaci potvrdíte v dialogu Sparkle.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfung einmal täglich. Download und Installation bestätigen Sie im Sparkle-Dialog."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked once a day. You confirm the download and installation in the Sparkle dialog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobación una vez al día. La descarga y la instalación se confirman en el diálogo de Sparkle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification une fois par jour. Vous confirmez le téléchargement et l'installation dans la fenêtre Sparkle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन में एक बार जाँच। डाउनलोड और इंस्टॉल की पुष्टि आप Sparkle डायलॉग में करते हैं।"
          }
        }
      }
    },
    "Kontrola překročila časový limit. Dokončete případný systémový dialog a zkuste ji znovu.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung hat das Zeitlimit überschritten. Schließen Sie einen eventuellen Systemdialog ab und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check timed out. Finish any system dialog and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprobación superó el tiempo límite. Complete el diálogo del sistema e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle a expiré. Terminez la boîte de dialogue système éventuelle et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँच का समय समाप्त हुआ। कोई सिस्टम डायलॉग हो तो पूरा करें और दोबारा प्रयास करें।"
          }
        }
      }
    },
