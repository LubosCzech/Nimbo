    "Aplikace i vybrané zbytky se přesunou do Koše.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App und die ausgewählten Restdaten werden in den Papierkorb bewegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app and the selected leftovers will be moved to the Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app y los restos seleccionados se moverán a la papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app et les résidus sélectionnés seront placés dans la corbeille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप और चुना गया बचा हुआ डेटा ट्रैश में ले जाया जाएगा।"
          }
        }
      }
    },
