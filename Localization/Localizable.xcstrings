    "Obsah Koše bude smazán natrvalo. Ostatní vybrané položky se přesunou do Koše.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt des Papierkorbs wird endgültig gelöscht. Die übrigen ausgewählten Objekte wandern in den Papierkorb."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contents of the Trash will be deleted permanently. The other selected items go to the Trash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido de la papelera se eliminará permanentemente. Los demás elementos seleccionados irán a la papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu de la corbeille sera supprimé définitivement. Les autres éléments sélectionnés iront à la corbeille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैश की सामग्री स्थायी रूप से मिटेगी। अन्य चयनित आइटम ट्रैश में जाएँगे।"
          }
        }
      }
    },
    "Obsazená paměť sama o sobě není problém: macOS v ní drží data, aby je nemusel číst z disku.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belegter Speicher ist für sich genommen kein Problem: macOS hält dort Daten, um nicht von der Festplatte lesen zu müssen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used memory is not a problem in itself: macOS keeps data there so it need not read from disk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria ocupada no es un problema en sí: macOS guarda datos allí para no leer del disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mémoire utilisée n'est pas un problème en soi : macOS y conserve des données pour éviter de lire le disque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोग में मेमोरी अपने आप में समस्या नहीं है: macOS उसमें डेटा रखता है ताकि डिस्क से न पढ़ना पड़े।"
          }
        }
      }
    },
    "Odebrat sekci z výběru": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswahl der Kategorie aufheben"
          }
        },
        "en": {
          "stringUnit": {
