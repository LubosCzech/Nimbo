    "System Events neběží, proto stav nelze zjistit. Není to důkaz zamítnutí oprávnění.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System Events läuft nicht, daher lässt sich der Zustand nicht ermitteln. Das ist kein Beleg für eine verweigerte Berechtigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Events is not running, so the state cannot be determined. That is not proof of a denied permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "System Events no se está ejecutando, así que no se puede determinar el estado. Eso no prueba que se haya denegado un permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "System Events n'est pas lancé, l'état ne peut donc pas être déterminé. Ce n'est pas la preuve d'une autorisation refusée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "System Events नहीं चल रहा, इसलिए स्थिति पता नहीं चल सकी। यह अनुमति अस्वीकृति का प्रमाण नहीं है।"
          }
        }
      }
    },
