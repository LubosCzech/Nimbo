    "Před každým odstraněním vidíte velikost i přesný seznam vybraných položek.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor jedem Entfernen sehen Sie die Größe und die genaue Liste der ausgewählten Objekte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before every removal you see the size and the exact list of selected items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de cada eliminación ves el tamaño y la lista exacta de los elementos seleccionados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant chaque suppression, vous voyez la taille et la liste exacte des éléments sélectionnés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर निष्कासन से पहले आप आकार और चयनित आइटम की सटीक सूची देखते हैं।"
          }
        }
      }
    },
    "Před odstraněním vždy uvidíte potvrzení": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Entfernen sehen Sie stets eine Bestätigung"
          }
        },
        "en": {
