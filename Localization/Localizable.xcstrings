    },
    "Pod desetinou volného místa si macOS hůř poradí s odkládáním i snímky disku.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter einem Zehntel freiem Speicher kommt macOS schlechter mit Auslagerung und Schnappschüssen zurecht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below a tenth of free space macOS copes worse with swapping and disk snapshots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por debajo de una décima parte de espacio libre, macOS gestiona peor el intercambio y las instantáneas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En dessous d'un dixième d'espace libre, macOS gère moins bien l'échange et les instantanés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दसवें हिस्से से कम खाली जगह पर macOS स्वैपिंग और स्नैपशॉट खराब ढंग से संभालता है।"
          }
        }
      }
    },
