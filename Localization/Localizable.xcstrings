    "Aktualizace zatím nejsou nakonfigurované. Chybí GitHub repozitář nebo veřejný podpisový klíč.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates sind noch nicht eingerichtet. Das GitHub-Repository oder der öffentliche Signaturschlüssel fehlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates are not configured yet. The GitHub repository or the public signing key is missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones aún no están configuradas. Falta el repositorio de GitHub o la clave pública de firma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour ne sont pas encore configurées. Le dépôt GitHub ou la clé de signature publique manque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपडेट अभी कॉन्फ़िगर नहीं हैं। GitHub रिपॉज़िटरी या सार्वजनिक हस्ताक्षर कुंजी अनुपलब्ध है।"
          }
        }
      }
    },
