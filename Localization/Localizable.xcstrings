          "stringUnit": {
            "state": "translated",
            "value": "Nach längerer Laufzeit lohnt sich ein Neustart des Macs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a long uptime it is worth restarting the Mac."
