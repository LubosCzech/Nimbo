        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimbo muestra lo que realmente afecta a la velocidad. Se mide al abrir la sección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimbo montre ce qui influence vraiment la vitesse. La mesure a lieu à l'ouverture de la section."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimbo दिखाता है कि गति पर वास्तव में क्या असर डालता है। माप अनुभाग खोलने पर होता है।"
          }
