    "Soubory se standardně přesouvají do Koše. Vyprázdnění Koše je nevratné.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien wandern standardmäßig in den Papierkorb. Das Leeren des Papierkorbs ist endgültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files go to the Trash by default. Emptying the Trash cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos van por defecto a la papelera. Vaciar la papelera es irreversible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers vont par défaut à la corbeille. Vider la corbeille est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें डिफ़ॉल्ट रूप से ट्रैश में जाती हैं। ट्रैश खाली करना अपरिवर्तनीय है।"
          }
        }
      }
    },
    "Souhlas ještě nebyl udělen. O systémový dialog požádáte tlačítkem Povolit automatizaci.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einwilligung wurde noch nicht erteilt. Die Taste „Automation erlauben“ ruft den Systemdialog auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consent has not been given yet. The Allow automation button asks for the system dialog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha dado el consentimiento. El botón «Permitir la automatización» solicita el diálogo del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le consentement n'a pas encore été donné. Le bouton « Autoriser l'automatisation » demande la boîte de dialogue système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहमति अभी नहीं दी गई। „ऑटोमेशन की अनुमति दें“ बटन सिस्टम डायलॉग माँगता है।"
          }
        }
